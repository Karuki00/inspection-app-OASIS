{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "inspection-app",
  "version": "0.1.0",
  "identifier": "com.inspectionapp.app",
  "build": {
    "devUrl": "http://127.0.0.1:8000",
    "frontendDist": "../resources",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Inspection App",
        "url": "http://127.0.0.1:8000",
        "width": 1024,
        "height": 768,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "externalBin": [
      "binaries/php"
    ],
    "resources": [
      "../app/**/*",
      "../bootstrap/**/*",
      "../config/**/*",
      "../database/**/*",
      "../public/**/*",
      "../resources/**/*",
      "../routes/**/*",
      "../storage/**/*",
      "../vendor/**/*",
      "../artisan",
      "../.env"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}